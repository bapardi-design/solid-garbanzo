# ---------- AI (required for `generate` and `revise`) ----------
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for copy generation.
AUTOPILOT_MODEL=claude-opus-5

# ---------- Review board: where drafts go for approval ----------
# local  -> markdown files in ./board (no account needed, edit in any editor / Obsidian / VS Code)
# notion -> a Notion database (recommended for clients)
BOARD=local
NOTION_TOKEN=secret_...
# Set by `autopilot notion:setup`, or paste the data source id of an existing board.
NOTION_DATA_SOURCE_ID=
# Only needed for `autopilot notion:setup` (the page the board database is created under).
NOTION_PARENT_PAGE_ID=

# ---------- Storage: where rendered images are hosted (publishers need a public URL) ----------
# local      -> files stay in ./out (fine with BOARD=local + PUBLISHER=dryrun)
# github     -> raw.githubusercontent.com URLs (repo must be public; the workflows commit ./out)
# cloudinary -> uploads to Cloudinary (works with private repos)
STORAGE=local
GITHUB_REPOSITORY=owner/repo
GITHUB_REF_NAME=main
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=autopilot

# ---------- Publisher: what actually posts to the channels ----------
# dryrun   -> logs what would be posted, marks the card as Posted (for testing)
# ayrshare -> Ayrshare (Instagram, TikTok, LinkedIn, Facebook, Pinterest, YouTube, X, Threads)
PUBLISHER=dryrun
AYRSHARE_API_KEY=
# Optional: Ayrshare Business plan profile key when you run several client brands.
AYRSHARE_PROFILE_KEY=

# ---------- Rendering ----------
# Optional: path to a Chrome/Chromium binary if you don't want `npx playwright install chromium`.
AUTOPILOT_CHROMIUM=

# ---------- Scheduling ----------
# IANA timezone used to interpret dates/times in the content plan.
AUTOPILOT_TZ=Europe/Berlin
# How far ahead `publish` looks for due posts (minutes). Keep >= the cron interval.
AUTOPILOT_PUBLISH_WINDOW_MINUTES=30
