{
  "name": "manager-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:engine": "cd ../sim-engine && npm ci --include=dev --no-audit --no-fund && npm run build && cd ../manager-app",
